{
    "name": "@gradecloud/api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "db:migrate": "tsx src/scripts/migrate.ts",
        "db:seed": "tsx src/scripts/seed.ts",
        "db:migrate:prod": "node dist/scripts/migrate.js",
        "db:seed:prod": "node dist/scripts/seed.js",
        "test": "vitest run"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^17.0.0",
        "express": "^5.1.0",
        "pg": "^8.16.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.15.0",
        "@types/supertest": "^6.0.2",
        "supertest": "^7.1.0",
        "tsx": "^4.20.0",
        "typescript": "^5.9.0",
        "vitest": "^3.2.0"
    }
}